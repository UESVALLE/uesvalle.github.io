# ==========================================================
# ARCHIVOS LOCALES - NO SUBIR A GITHUB
# ==========================================================

# Scripts locales de procesamiento
scripts/

# Credenciales y variables de entorno
.env
.env.*
!.env.example
*.env

# Logs y temporales
logs/
*.log
*.tmp
__pycache__/
*.pyc
**/~$*.xlsx
**/~$*.xls

# Carpetas de archivo/histórico local
archive/
data/**/archive/
data/**/historical/
data/**/logs/

# Datos fuente o brutos
data/raw/
data/**/raw/

# Archivos temporales de Excel
~$*.xlsx
~$*.xls

# Configuración local de VS Code
.vscode/
.vscodesettings.json

# Insumos locales por módulo
data/**/input/
# MPR - archivos locales/no publicar
/scripts/mpr/config_sisa.env
/data/mpr/raw/censo_visitasMPR.xlsx
/data/mpr/raw/censo_visitasMPR_backup_*.xlsx
